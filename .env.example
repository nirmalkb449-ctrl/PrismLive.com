SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=0
# Optional absolute path for a persistent SQLite database
# DATABASE_PATH=/absolute/path/to/prismlive.db

# Gemini AI assistant (server-side only)
GEMINI_API_KEY=your_private_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# UPI payment intent configuration (replace with your actual merchant UPI details)
UPI_ID=yourmerchant@upi
UPI_PAYEE_NAME=PrismLive
