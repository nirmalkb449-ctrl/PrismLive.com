# Local development only. Generate a random secret for any deployed environment.
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=0
# Local SQLite default is ./prismlive.db. Render Blueprint uses /var/data/prismlive.db.
# DATABASE_PATH=/absolute/path/to/prismlive.db

# Optional Gemini AI assistant (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional UPI payment intent configuration (set only to your real merchant details)
UPI_ID=
UPI_PAYEE_NAME=PrismLive

# Password reset email (SMTP). For Gmail, use an App Password, not your normal password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=Prism Live <your-email@gmail.com>
